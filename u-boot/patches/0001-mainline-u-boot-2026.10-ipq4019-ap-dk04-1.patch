diff --git a/arch/arm/mach-ipq40xx/cpu.c b/arch/arm/mach-ipq40xx/cpu.c
index 92c34d61118..67a66e0496b 100644
--- a/arch/arm/mach-ipq40xx/cpu.c
+++ b/arch/arm/mach-ipq40xx/cpu.c
@@ -9,6 +9,7 @@
 
 #include <cpu_func.h>
 #include <init.h>
+#include <asm/io.h>
 
 int dram_init(void)
 {
@@ -41,3 +42,31 @@ int __weak board_init(void)
 {
 	return 0;
 }
+
+/* Minimal architected timer / reset stubs for IPQ40xx */
+unsigned long get_tbclk(void)
+{
+	return 48000000UL; /* arch_sys_counter freq from Linux log */
+}
+
+unsigned long long timer_read_counter(void)
+{
+	unsigned long lo, hi;
+
+	asm volatile("mrrc p15, 0, %0, %1, c14" : "=r"(lo), "=r"(hi));
+	return ((unsigned long long)hi << 32) | lo;
+}
+
+int print_cpuinfo(void)
+{
+	printf("CPU:   IPQ4019 (Cortex-A7)\n");
+	return 0;
+}
+
+void reset_cpu(void)
+{
+	/* IPQ4019 pshold: write 0 to trigger cold reset (Linux msm-poweroff) */
+	writel(0, (void __iomem *)0x4ab000);
+	while (1)
+		;
+}
